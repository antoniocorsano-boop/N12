    "viewer_render_is_derived_review_aid_only": true,
    "tile_pyramid_is_derived_review_aid_only": true,
    "viewer_may_write_canonical_data": false,
    "viewer_may_promote_epistemic_state": false,
    "viewer_may_relocalize_region": false,
    "enhancement_may_replace_original": false
