{
  "contract_id": "CEW-SOURCE-VIEWER-v1",
  "milestone": "CEW-F3",
  "purpose": "Provide reproducible read-only deep navigation from a CEW task or EvidenceRegion to the immutable primary-source page without altering F2 geometry or engineering authority.",
  "viewer_engine": {"name": "OpenSeadragon", "version": "5.0.1", "runtime_distribution": "VENDORED_SELF_CONTAINED"},
  "tile_generator": {"name": "libvips", "format": "DZI", "tile_size": 256, "overlap": 1},
  "pdf_renderer": {"name": "PyMuPDF", "version": "1.26.4", "minimum_dpi": 300},
  "reference_tasks": ["ERW-N12-001", "ERW-N12-002", "ERW-N12-003", "ERW-N12-004", "OA-N12-G4-COLUMN-PILOT"],
  "required_behaviors": ["PAN","ZOOM","HOME","OVERVIEW_NAVIGATOR","REGION_DEEP_LINK","TASK_DEEP_LINK","FIT_EVIDENCE_REGION","SOURCE_IDENTITY_VISIBLE","OBSERVATION_STATE_VISIBLE","PRIMARY_VS_DERIVED_AUTHORITY_VISIBLE"],
  "coordinate_policy": {
