    "ORIENTATION": "Prefer explicit orientation_class when both prototype and candidate provide it; otherwise fall back to geometric orientation.",
    "SPATIAL_CONTEXT": "Context is only a similarity signal and never proves source-page position or structural identity.",
    "ASSOCIATED_TEXT": "Associated text contributes only as an explainable similarity signal."
  },
  "scoring": {
    "deterministic": true,
    "explainable_reason_codes_required": true,
    "weights_versioned": true,
    "weights_version": "OA3-DIMENSION-AWARE-v1.1",
    "default_weights": {
      "GEOMETRY_KIND": 0.20,
      "DIMENSION_RATIO": 0.30,
      "ORIENTATION": 0.15,
      "TOPOLOGY_HINT": 0.10,
      "SPATIAL_CONTEXT": 0.10,
      "ASSOCIATED_TEXT": 0.15
    },
    "thresholds": {
      "STRONG_SIMILAR_MIN": 0.85,
      "POSSIBLE_SIMILAR_MIN": 0.60
    }
  },
  "result_states": ["STRONG_SIMILAR", "POSSIBLE_SIMILAR", "WEAK", "EXCLUDED"],
  "governance": {
