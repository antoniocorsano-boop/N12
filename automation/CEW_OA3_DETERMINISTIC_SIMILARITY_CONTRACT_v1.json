  "signals_v1": [
    "GEOMETRY_KIND",
    "DIMENSION_RATIO",
    "ORIENTATION",
    "TOPOLOGY_HINT",
    "SPATIAL_CONTEXT",
    "ASSOCIATED_TEXT"
