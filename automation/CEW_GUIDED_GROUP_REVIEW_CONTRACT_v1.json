    "oar_human_confirmation": false,
    "oar_classification_confirmed": false,
    "canonical_write_authorized": false,
    "structural_identity_authorized": false,
    "engineering_authority_effect": "NONE"
  },
  "non_negotiable_invariants": [
    "SIMILARITY_BAND_IS_NOT_CLASSIFICATION",
    "GROUP_CONFIRMATION_IS_PROJECT_LOCAL_TRAINING_EVIDENCE_ONLY",
    "TRAINING_EXAMPLES_CANNOT_BE_RESELECTED_IN_THE_SAME_MEMORY_STATE",
    "GROUP_RECEIPT_MUST_BIND_MEMORY_FINGERPRINT_AND_EVIDENCE_FINGERPRINTS",
    "NO_F2_MUTATION",
    "NO_STRUCTURAL_IDENTITY",
    "NO_CANONICAL_ENGINEERING_WRITE",
    "EXCEPTIONS_REMAIN_VISIBLE_AND_REVIEWABLE"
