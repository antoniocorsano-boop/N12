{
  "schema_version": "0.4.0",
  "principle": "Work items depend on capabilities and contracts, not on one hard-coded agent or library.",
  "capabilities": {
    "source.identity": {
      "class": "CORE",
      "providers": ["cew-source-foundation"],
      "required_invariants": ["immutable_or_versioned_source", "content_fingerprint"]
    },
    "evidence.provenance": {
      "class": "CORE",
      "providers": ["cew-evidence-foundation"],
      "required_invariants": ["reconstructible_lineage", "explicit_epistemic_state"]
    },
    "document.raster_geometry": {
      "class": "SPECIALIST_PORT",
      "providers": ["opencv-cew-adapter", "future-compatible-geometry-adapter"],
      "selection": "BENCHMARK_OR_PROJECT_POLICY",
      "required_invariants": ["native_coordinates", "detector_version", "no_silent_promotion"]
    },
    "document.pdf_programmatic": {
      "class": "SPECIALIST_PORT",
      "providers": ["pymupdf-adapter", "docling-parse-adapter"],
      "selection": "MULTI_READER_ALLOWED",
      "required_invariants": ["page_coordinates", "source_version_binding"]
    },
    "document.ocr_htr": {
      "class": "SPECIALIST_PORT",
      "providers": ["tesseract-baseline", "paddleocr-benchmark", "future-htr-adapter"],
      "selection": "PROFILE_AND_BENCHMARK",
      "required_invariants": ["bbox", "confidence_or_score", "model_version", "human_review_for_semantic_promotion"]
    },
    "document.symbol_learning": {
      "class": "CEW_DOMAIN_CAPABILITY",
      "providers": ["cew-docintel-symbol-learning"],
      "required_invariants": ["positive_negative_uncertain_labels", "source_context", "human_validated_meaning", "project_bound_examples"]
    },
    "knowledge.graphic_conventions": {
      "class": "CEW_SYSTEM_CAPABILITY",
      "providers": ["cew-graphic-knowledge-fabric"],
      "selection": "GLOBAL_FAMILY_PROJECT_AFFINITY_ENSEMBLE",
      "required_invariants": [
        "cross_project_provenance",
        "stable_candidate_identity",
        "positive_negative_uncertain_transfer",
        "affinity_weighted_retrieval",
        "project_specialization_overlay",
        "conflict_exposure",
        "imported_knowledge_not_local_authority",
        "human_validated_generalization"
      ]
    },
    "human.graphic_review": {
      "class": "CEW_SYSTEM_CAPABILITY",
      "providers": ["cew-system-graphic-review-workspace"],
      "selection": "PROJECT_EVIDENCE_PLUS_GRAPHIC_KNOWLEDGE",
      "required_invariants": [
        "source_region_beside_suggestion",
        "explainable_local_affine_family_global_layers",
        "project_human_semantic_authority",
        "positive_negative_uncertain_decisions",
        "source_generation_drift_fails_closed",
        "project_specialization_before_shared_contribution",
        "no_automatic_generalization"
      ]
    },
    "knowledge.smart_entity": {
      "class": "CEW_DOMAIN_CAPABILITY",
      "providers": ["cew-smart-entity-core"],
      "required_invariants": ["stable_identity", "property_epistemic_state", "generation_history"]
    },
    "model.graph": {
      "class": "CEW_DOMAIN_CAPABILITY",
      "providers": ["cew-canonical-model-builder"],
      "required_invariants": ["explicit_topology", "stable_ids", "evidence_or_rule_binding"]
    },
    "model.ifc_projection": {
      "class": "SPECIALIST_PORT",
      "providers": ["ifcopenshell-adapter"],
      "selection": "WHEN_INTEROPERABILITY_REQUIRED",
      "required_invariants": ["round_trip_identity_mapping", "projection_not_authority"]
    },
    "analysis.fem": {
      "class": "SPECIALIST_PORT",
      "providers": ["openseespy-adapter", "code-aster-adapter", "edilus-external-adapter"],
      "selection": "SCENARIO_AND_BENCHMARK",
      "required_invariants": ["scenario_manifest", "entity_mapping", "unsupported_features_explicit"]
    },
    "degradation.registry": {
      "class": "CEW_DOMAIN_CAPABILITY",
      "providers": ["cew-degradation-engine"],
      "required_invariants": ["applicability", "parameter_provenance", "calibration_state"]
    },
    "investigation.voi": {
      "class": "CEW_DOMAIN_CAPABILITY",
      "providers": ["cew-investigation-planner"],
      "required_invariants": ["decision_relevant_uncertainty", "test_cost_placeholder", "expected_information_gain"]
    },
    "intervention.intelligence": {
      "class": "CEW_DOMAIN_CAPABILITY",
      "providers": ["cew-intervention-engine"],
      "required_invariants": ["deficiency_objective_candidate_chain", "human_selection", "new_model_generation"]
    },
    "quantity.cost": {
      "class": "CEW_DOMAIN_CAPABILITY",
      "providers": ["cew-quantity-cost-engine"],
      "required_invariants": ["entity_generation_binding", "price_generation_binding", "reproducible_delta"]
    },
    "human.review": {
      "class": "CORE",
      "providers": ["cew-human-decision-workspace"],
      "required_invariants": ["evidence_beside_candidate", "explicit_decision", "receipt"]
    },
    "workflow.durable_execution": {
      "class": "EXECUTION_INFRASTRUCTURE",
      "providers": ["deterministic-cew-orchestrator", "langgraph-benchmark-adapter"],
      "selection": "CEW_CONTRACT_REMAINS_AUTHORITY",
      "required_invariants": ["checkpoint_resume", "idempotent_transition", "human_gate_resume"]
    }
  }
}
