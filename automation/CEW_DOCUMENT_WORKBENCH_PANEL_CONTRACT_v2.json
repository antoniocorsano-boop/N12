{
  "schema": "CEW_DOCUMENT_WORKBENCH_PANEL_CONTRACT_v2",
  "architecture_id": "CEW_PROFESSIONAL_DOCUMENT_WORKBENCH_V2",
  "status": "CANONICAL_UI_ARCHITECTURE_CANDIDATE",
  "design_reference_policy": "BEHAVIORAL_REFERENCE_ONLY_NO_CODE_COPY",
  "open_source_references": [
    {
      "name": "Microsoft VS Code Agents Window layout",
      "url": "https://github.com/microsoft/vscode/blob/main/src/vs/sessions/LAYOUT.md",
      "adopted_principles": [
        "stable part ownership",
        "flexible central surface absorbs resize",
        "primary and auxiliary side parts preserve user-established sizes",
        "layout state is persisted independently from domain state"
      ]
    },
    {
      "name": "Microsoft VS Code workbench source organization",
      "url": "https://github.com/microsoft/vscode/wiki/Source-Code-Organization",
      "adopted_principles": [
        "workbench shell is infrastructure",
        "feature contributions stay decoupled from workbench core"
      ]
    },
    {
      "name": "OpenHands Agent Canvas",
      "url": "https://github.com/OpenHands/agent-canvas",
      "adopted_principles": [
        "single workspace coordinates files, terminal/browser-like tools and contextual state",
        "frontend shell remains distinct from execution authority"
      ]
    }
  ],
  "topology": [
    "TITLE_BAR",
    "COMMAND_BAR",
    "ACTIVITY_RAIL",
    "PRIMARY_SIDEBAR",
    "EDITOR_CANVAS",
    "AUXILIARY_SIDEBAR",
    "STATUS_BAR"
  ],
  "panel_ownership": {
    "ACTIVITY_RAIL": "view switching only",
    "PRIMARY_SIDEBAR": "pages, primitives, clusters, verification queues",
    "EDITOR_CANVAS": "original document reading and geometry interaction",
    "AUXILIARY_SIDEBAR": "contextual properties, provenance, governed human decision",
    "STATUS_BAR": "persistent viewport, acquisition and authority state"
  },
  "layout_state": {
    "storage_key": "cew.documentDiscovery.workbench.v2",
    "persist": [
      "leftWidth",
      "rightWidth",
      "leftVisible",
      "rightVisible",
      "activeNav",
      "activeInspector"
    ],
    "primary_width_px": {
      "default": 292,
      "min": 220,
      "max": 500
    },
    "auxiliary_width_px": {
      "default": 336,
      "min": 260,
      "max": 560
    }
  },
  "interaction_contract": {
    "primary_sidebar": [
      "activity view selection",
      "collapse and restore",
      "drag resize",
      "keyboard resize",
      "double-click width reset"
    ],
    "auxiliary_sidebar": [
      "properties tab",
      "provenance tab",
      "decision tab only when teaching is governed",
      "collapse and restore",
      "drag resize",
      "keyboard resize",
      "double-click width reset"
    ],
    "editor_canvas": [
      "fit page",
      "fit width",
      "wheel zoom around cursor",
      "drag pan",
      "90-degree rotation",
      "direct cluster hotspot selection"
    ]
  },
  "result_semantics": {
    "analysis_completed_is_not_graphic_evidence_found": true,
    "zero_primitive_zero_cluster_state": "WARNING_REVIEW_REQUIRED"
  },
  "authority_invariants": {
    "automatic_semantic_authority": "NONE",
    "unregistered_preview_training": "BLOCKED",
    "canonical_write": "BLOCKED",
    "structural_identity": "BLOCKED",
    "engineering_authority_effect": "NONE",
    "original_document_authority": "EVIDENTIARY"
  }
}
